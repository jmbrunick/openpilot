# NAP animal detector: compile models/animal_yolox_nano.onnx to a tinygrad pickle,
# the same compile3 path and QCOM flags as the driver-monitoring model.
import glob
import os
import subprocess
import sys

Import('env', 'arch')

root = env.Dir("#").abspath
tinygrad_files = ["#" + x for x in glob.glob(env.Dir("#tinygrad_repo").relpath + "/**", recursive=True, root_dir=root)
                  if 'pycache' not in x and os.path.isfile(os.path.join(root, x))]

def _devices():
  try:
    return set(subprocess.run([sys.executable, '-c', 'from tinygrad import Device\nprint("\\n".join(Device.get_available_devices()))'],
                              capture_output=True, text=True, check=True).stdout.split())
  except Exception:
    return set()

avail = _devices()
if 'QCOM' in avail:
  flags = 'DEV=QCOM IMAGE=1 FLOAT16=1 NOLOCALS=1 JIT_BATCH_SIZE=0 OPENPILOT_HACKS=1'
else:
  flags = 'DEV=CPU' if arch == 'Darwin' else 'DEV=CPU:LLVM'

here = Dir('.').abspath
onnx = File('models/animal_yolox_nano.onnx').abspath
pkl = os.path.join(here, 'models', 'animal_yolox_nano_tinygrad.pkl')
pythonpath = 'PYTHONPATH="${PYTHONPATH}:' + env.Dir("#tinygrad_repo").abspath + '"'
# No model committed yet (log-only stub stage): skip, so the main build never
# fails on a missing ONNX. animaldetd then logs status "no_model" and idles.
if os.path.isfile(onnx):
  env.Command(pkl, [onnx] + tinygrad_files,
              f'{pythonpath} {flags} python3 {env.Dir("#tinygrad_repo").abspath}/examples/openpilot/compile3.py {onnx} {pkl}')
